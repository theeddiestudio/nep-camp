<% layout('./layouts/boilerplate') -%>
<h1 class="text-center">Edit Campground</h1>
<div class="col-6 offset-3">
    <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="post">
        <div class="mb-3">
            <label class="form-label" for="name">Name of the campground</label>
            <input class="form-control" type="text" id="name" name="campground[name]" value="<%= campground.name %>">
        </div>
        <div class="mb-3">
            <label  class="form-label" for="location">Enter location</label>
            <input class="form-control" type="text" id="location" name="campground[location]" value="<%= campground.location %>">
        </div>
        <div class="mb3">
            <label for="price" class="form-label">Enter Price</label>
            <div class="input-group mb-3">
                <span class="input-group-text" id="price-label">$</span>
                <input type="text" class="form-control" placeholder="0.00" id="price" aria-label="price" aria-describedby="price-label" name="campground[price]" value="<%= campground.price %>">
            </div>
        </div>
        <div class="mb-3">
            <label  class="form-label" for="image">Enter image url</label>
            <input class="form-control" type="text" id="image" name="campground[image]" value="<%= campground.image %>">
        </div>
        <div class="mb-3">
            <label class="form-label" for="description">Enter description</label>
            <textarea class="form-control" type="text" id="description" name="campground[description]"><%= campground.description%></textarea>
        </div>
        <div class="b-3">
            <button class="btn btn-info">Save</button>
        </div>
    </form>
    <a href="/campgrounds/<%= campground._id %>">Cancel</a>
</div>