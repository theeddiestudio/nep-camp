<% layout('./layouts/boilerplate') -%>
<h1>All Campgrounds</h1>
<a href="/campgrounds/new">Add New</a>
<% for( let camp of campgrounds ) { %>
    <div class="card mb3">
        <div class="row">
            <div class="col-md-4">
                <img src="<%= camp.image %>" alt="" class="img-fluid">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title"><%= camp.name %></h5>
                    <p class="card-text"><%= camp.description %></p>
                    <p class="card-text">
                        <small class="text-secondary"><%= camp.location %></small>
                    </p>
                    <a href="/campgrounds/<%= camp._id %>" class="btn btn-primary">
                        Read More
                    </a>
                </div>
            </div>
        </div>
    </div>
<% } %>